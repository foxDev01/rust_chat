# Пример конфигурации клиента. Скопируйте в `frontend/.env.local`
# (добавлен в .gitignore) при необходимости изменить значения по умолчанию.

# Явный адрес WebSocket, если сервер живёт на другом хосте или порту.
# По умолчанию используется тот же хост, что и у страницы, — wss на https, ws на http.
# VITE_WS_URL=ws://localhost:3000/ws

# Куда Vite проксирует /api и /ws в режиме разработки.
# Переменная читается из окружения терминала, а не из этого файла:
#   $env:CHAT_DEV_BACKEND = "http://127.0.0.1:3000"; npm run dev
# CHAT_DEV_BACKEND=http://127.0.0.1:3000
