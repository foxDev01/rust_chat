# Пример конфигурации сервера. Скопируйте файл в `.env` и подставьте свои
# значения; сам `.env` добавлен в .gitignore и в репозиторий не попадает.
#
# Файл читается не автоматически: переменные нужно передать окружению, например
#   Get-Content .env | ForEach-Object { ... } ; cargo run
# или задать напрямую в терминале / в настройках хостинга.

# Адрес и порт прослушивания (по умолчанию 0.0.0.0:3000)
CHAT_BIND=0.0.0.0:3000

# Обязательная строка подключения к PostgreSQL
CHAT_DB_URL=postgres://postgres:postgres@localhost:5432/rust_chat

# Уровень логирования
RUST_LOG=rust_chat=info,tower_http=info

# Доверять заголовкам X-Forwarded-For / X-Real-IP при подсчёте лимитов.
# Включайте только если сервер стоит за своим reverse proxy и недоступен напрямую:
# иначе клиент подделает IP и обойдёт ограничение попыток входа.
CHAT_TRUST_PROXY=false

# Дополнительные источники WebSocket через запятую.
# Нужны, только если клиент открывает страницу не с того же хоста, что и сервер,
# например https://chat.example.com при открытом порту 3000.
# Пусто = разрешён только same-origin.
CHAT_ALLOWED_ORIGINS=
